#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Validates the one-line Conventional Commit format.
set -euo pipefail
msg_file="$1"
lines=$(grep -vc '^#' "$msg_file" || true)
first=$(grep -v '^#' "$msg_file" | head -n1)
if [ "$lines" -ne 1 ]; then
  echo "commit-msg: message must be exactly one line" >&2
  exit 1
fi
re='^(feat|fix|perf|refactor|test|docs|build|ci|chore)(\([a-z0-9-]+\))?!?: [a-z0-9].{0,70}[^.]$'
if ! printf '%s' "$first" | grep -Eq "$re"; then
  echo "commit-msg: '$first' does not match $re" >&2
  exit 1
fi
if [ "${#first}" -gt 72 ]; then
  echo "commit-msg: subject longer than 72 characters" >&2
  exit 1
fi
